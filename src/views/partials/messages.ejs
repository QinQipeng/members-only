<ul>
  <% messages.forEach((msg) => { %>
    <li>
      <div>
        <em>Posted by <strong><%= msg.senderId === user.id ? "Me" : msg.senderName %> </strong>At: <%= msg.createdAt %></em>
        <% if (!(user.isAdmin ||msg.senderId === user.id)) { %>
          <p><em>"The message is anonymized for other users by default"</em></p>
        <% } else { %>
          <h3><%= msg.title %></h3>
          <p><%= msg.content %></p>
          <% if (user.isAdmin) { %>
            <form action="/deleteMsg/<%= msg.id %>" method="get">
              <button type="submit" onclick="return confirm('Are you sure you want to delete this message?');">
                Delete
              </button>
            </form>
          <% } %>
        <% } %>
      </div>
    </li>
  <% }) %>
</ul>