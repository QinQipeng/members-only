<ul>
  <% messages.forEach((msg) => { %>
    <li>
      <div>
        <em>Posted by <strong><%= msg.senderId === user.id ? "Me" : msg.senderName %> </strong>At: <%= msg.createdAt %></em>
        <% if (msg.senderId !== user.id) { %>
          <p><em>"The message is anonymized for other users by default"</em></p>
        <% } else { %>
          <h3><%= msg.title %></h3>
          <p><%= msg.content %></p>
        <% } %>
      </div>
    </li>
  <% }) %>
</ul>