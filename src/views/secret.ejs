<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Activate Your Account</title>
</head>
<body>
  <h1>Activate Your Account</h1>
  <% if (!(locals.attempts > 0)) { %>
    <p>Input the secret code to activate account for <%= user.firstName %> <%= user.lastName %></p>
  <% } else { %>
    <p>Wrong passcode. You have attempted <%= locals.attempts %> times</p>
  <% } %>
  <form action="/activate/<%= user.id %>" method="post">
    <label for="secret">Secret Code:</label>
    <input type="text" name="secret" id="secret">
    <button type="submit">Submit</button>
  </form>
  <a href="/log-out">Back to Login Page</a>
</body>
</html>